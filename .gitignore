# Unity project for this repo lives in unity-second-life-system/, not at the git root.
# The stock template anchors generated folders with a leading slash, which only
# matches the git root, so Library, Temp, Logs, UserSettings, and the rest were
# never ignored. These patterns match those names at any depth.
#
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Keep Assets/, Packages/, ProjectSettings/, and .vsconfig. Those belong in version control.

# Generated Unity folders
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.log

# Blender writes *.blend1 backups next to imported .blend assets
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size and can contain sensitive data
[Mm]emoryCaptures/

# Recordings can get excessive in size
[Rr]ecordings/

# Uncomment to ignore the Asset Store Tools plugin
# **/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
**/[Aa]ssets/Plugins/Editor/JetBrains*
# Rider personal-layer settings and local IDE state
*.DotSettings.user
.idea/

# Visual Studio cache
.vs/

# Gradle cache (Android / Unity)
.gradle/

# Autogenerated VS / Rider / Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for the debug databases above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Player and package build output
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Crashlytics
crashlytics-build.properties

# Test Runner generated scenes
InitTestScene*.unity*
**/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables output, before user customizations
ServerData/
**/[Aa]ssets/StreamingAssets/aa*
**/[Aa]ssets/AddressableAssetsData/link.xml*
**/[Aa]ssets/Addressables_Temp*
# addressables_content_state.bin lands in platform subfolders, for example
# Assets/AddressableAssetsData/OSX/addressables_content_state.bin
**/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# UI Toolkit generated schema
UIElementsSchema/

# Auto-generated cache and coverage data
**/[Aa]ssets/[Ss]ceneDependencyCache*
[Cc]odeCoverage/

# OS junk
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
