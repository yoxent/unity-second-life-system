<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Navigation/NavigationBar.uss?fileID=7433441132597879392&amp;guid=91f030ed03c7bd44e81880b89527fc73&amp;type=3#NavigationBar" />
    <!--
      The document root spans the viewport, so it would otherwise catch every pick
      aimed at the screen underneath. Clicks are re-enabled per element below it:
      nav-bar for the bar itself, and nav-group-flyout for the panels. The
      controller also sets root.pickingMode to Ignore, so the behaviour does not
      depend on remembering this attribute.
    -->
    <ui:VisualElement name="nav-root" class="nav-root" picking-mode="Ignore">
        <ui:VisualElement name="nav-bar" class="nav-bar">
            <ui:VisualElement name="nav-groups" class="nav-groups" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
