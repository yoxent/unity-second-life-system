:root {
    /*
     * Palette, spacing, and the navigation inset live in ValidationTheme.tss.
     * Only what is specific to this screen is declared here.
     *
     * This screen used to repeat the whole palette. That copy and the bar's copy
     * were two files that had to be edited together, which is exactly the drift
     * the theme removes.
     */
    --gap-edge: 28px;

    /* From the theme, so this screen's reserved bar height stays tied to the
       bar's own height rather than to a number copied into this file. */
    --nav-inset: var(--nav-inset-wide);
}

/*
 * The screen fills the viewport. This is a point-and-click surface, not a
 * centred card: the player navigates by buttons, so the interactive area is the
 * whole screen and every region is reachable without hunting for a box.
 *
 * The root stretches instead of centring. A fixed max-width card would waste the
 * sides and shrink the button targets as resolution drops.
 */
.status-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--bg-page);
    padding-left: var(--gap-edge);
    padding-right: var(--gap-edge);
    padding-top: var(--gap-edge);

    /* The navigation bar overlays the bottom of the viewport. Screens reserve its
       height so the footer stays visible and clickable instead of sitting under
       it. */
    padding-bottom: var(--nav-inset);
}

/*
 * Column layout with a header, a content region that consumes the leftover
 * height, and a footer. Content is the only flexible band, so the header and
 * footer stay put when a tab's contents differ in length.
 */
.status-frame {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--bg-panel);
}

/* ---- Header: identity on the left, a live summary on the right ---- */

.status-header {
    flex-direction: column;
    flex-shrink: 0;
    background-color: var(--bg-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--hairline);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
}

/* Identity left, the always-visible readout right. */
.header-main {
    flex-direction: row;
    align-items: flex-start;
}

.identity-block {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.status-heading {
    font-size: 14px;
    letter-spacing: 6px;
    color: var(--accent-dim);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.status-identity {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.identity-portrait-host {
    width: 120px;
    height: 120px;
    margin-right: 20px;
    flex-shrink: 0;
}

.portrait-frame {
    width: 120px;
    height: 120px;
    background-color: var(--bg-portrait);
    border-width: 2px;
    border-color: var(--border-portrait);
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.portrait-image {
    flex-grow: 1;
    align-self: stretch;
    -unity-background-scale-mode: scale-and-crop;
}

.portrait-placeholder {
    font-size: 36px;
    color: var(--portrait-placeholder);
}

.portrait-placeholder--hidden {
    display: none;
}

.identity-details {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
}

.character-name {
    font-size: 34px;
    color: var(--ink);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.identity-meta {
    flex-direction: row;
    flex-wrap: wrap;
}

.identity-meta-item {
    flex-direction: column;
    margin-right: 28px;
    margin-bottom: 4px;
}

.status-caption {
    font-size: 12px;
    color: var(--ink-muted);
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.identity-meta-value {
    font-size: 18px;
    color: var(--ink-meta);
    margin-top: 2px;
}

/* The always-visible readout. A point-and-click game shows the numbers the
   player checks most often without making them open a tab. */
.status-summary {
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
    margin-left: var(--gap-block);
    padding-left: 24px;
    border-left-width: 1px;
    border-left-color: var(--hairline);
}

.summary-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.summary-label {
    width: 64px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ink-muted);
    -unity-font-style: bold;
}

.summary-value {
    font-size: 22px;
    color: var(--ink);
    -unity-text-align: middle-right;
    min-width: 64px;
}

/* ---- Content: fills the remaining height, never scrolls the frame ---- */

.status-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: var(--gap-block);
}

.content-panel {
    flex-direction: column;
    background-color: var(--bg-panel-raised);
    border-radius: var(--radius-panel);
    padding: 20px;
}

.content-panel--description {
    width: 30%;
    flex-shrink: 0;
    margin-right: var(--gap-block);
}

.content-panel--tabs {
    flex-grow: 1;
    flex-shrink: 1;
}

.identity-description {
    font-size: 17px;
    color: var(--ink-description);
    white-space: normal;
    -unity-font-style: italic;

    /* line-height is not a USS property and was silently ignored here. Paragraph
       spacing is the supported equivalent for a wrapped text block. */
    -unity-paragraph-spacing: 5px;
}

.status-section-heading {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--ink-muted);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* ---- Attributes and derived, side by side and filling the panel ---- */

.status-body {
    flex-direction: row;
    flex-grow: 1;
    align-items: flex-start;
}

.status-column {
    flex-direction: column;
}

.status-attributes {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--gap-block);
}

.status-derived {
    flex-grow: 1;
    flex-basis: 0;
}

.attribute-row {
    flex-direction: row;
    align-items: center;
    height: 38px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hairline);
}

.attribute-label {
    width: 68px;
    font-size: 19px;
    color: var(--accent);
    -unity-font-style: bold;
}

.attribute-value {
    flex-grow: 1;
    -unity-text-align: middle-right;
    font-size: 22px;
    color: var(--ink);
}

.derived-row {
    flex-direction: row;
    align-items: center;
    height: 38px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hairline);
}

.derived-label {
    flex-grow: 1;
    font-size: 19px;
    color: var(--ink-soft);
}

.derived-value {
    font-size: 22px;
    color: var(--ink);
    -unity-text-align: middle-right;
}

.status-footnote {
    font-size: 14px;
    color: var(--ink-faint);
    white-space: normal;
    margin-top: 12px;

    /* Was line-height: 1.4, which USS ignores. */
    -unity-paragraph-spacing: 5px;
}

/* ---- Assessment ---- */

.status-assessment {
    flex-direction: column;
    border-top-width: 1px;
    border-top-color: var(--hairline);
    margin-top: 20px;
    padding-top: 16px;
}

.assessment-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
}

.assessment-label {
    flex-grow: 1;
    font-size: 19px;
    color: var(--ink-soft);
}

.assessment-label--titles {
    margin-top: 12px;
    color: var(--ink-muted);
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.assessment-value {
    font-size: 20px;
    color: var(--ink);
    -unity-text-align: middle-right;
}

.status-titles {
    flex-direction: column;
    margin-top: 4px;
}

.status-title {
    font-size: 17px;
    color: var(--ink-soft);
}

.status-title--none {
    color: var(--ink-faint);
}

/* ---- Resource bars: label, current/max readout, and a fill ---- */

.summary-bar-host {
    margin-bottom: 8px;
}

.derived-bar-host {
    margin-bottom: 16px;
}

.resource-row {
    flex-direction: column;
}

.resource-label {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ink-muted);
    -unity-font-style: bold;
}

.resource-value {
    font-size: 20px;
    color: var(--ink);
    margin-top: 2px;
    margin-bottom: 5px;
}

/* The track. A fixed height keeps every bar the same thickness regardless of
   the font size beside it, so stacked bars line up. */
.resource-bar {
    height: 8px;
    flex-direction: row;
    background-color: var(--bar-track);
    border-radius: 4px;
    overflow: hidden;
}

/*
 * The fill width is set from C# as a percentage of the pool, which the UI
 * standards permit for a value that depends on runtime state. Everything else
 * about the bar, including its colour, is authored here.
 */
.resource-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.15s;
}

.resource-bar-fill--health {
    background-color: var(--bar-health);
}

.resource-bar-fill--mana {
    background-color: var(--bar-mana);
}

/* An empty pool still shows a track, so the row never collapses to nothing.
   It only changes the fill colour, not the layout. */
.resource-bar--health.resource-bar {
    background-color: var(--bar-track);
}

.resource-bar--mana.resource-bar {
    background-color: var(--bar-track);
}

/* ---- Footer ---- */

.status-footer {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: var(--hairline);
    background-color: var(--bg-header);
    padding-left: 24px;
    padding-right: 24px;
    height: 40px;
}

.status-footer-hint {
    font-size: 13px;
    color: var(--ink-faint);
    letter-spacing: 1px;
}

/* ---- Breakdown popover ----
 *
 * Explains a value the player is looking at: the base, each contribution, and the
 * final. Opened by hovering or latching a value; see BreakdownPopover.
 *
 * Absolute so it overlays the screen instead of reflowing it. There is no
 * z-index in USS; panel order decides, and this element is the last child of
 * status-root, so it draws above the frame.
 *
 * Width is fixed rather than content-driven so a long label cannot stretch the
 * panel across the screen, and so the numbers stay aligned between one value's
 * popover and the next.
 */
.breakdown-popover {
    position: absolute;
    width: 268px;
    flex-direction: column;
    background-color: var(--bg-popover);
    border-width: 1px;
    border-color: var(--border-popover);
    border-radius: var(--radius-panel);
    padding: 12px 14px;

    /* Hidden until a value is hovered or latched. BreakdownPopover sets this to
       flex; the default keeps it out of flow before any interaction. */
    display: none;
}

.breakdown-title {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--ink-muted);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.breakdown-lines {
    flex-direction: column;
}

.breakdown-line {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.breakdown-line-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    color: var(--ink-soft);
}

/* Contributions are tinted toward the accent: they are the explanation, and the
   eye should find them before the base and final rows that bracket them. */
.breakdown-line-value {
    font-size: 14px;
    color: var(--accent);
    -unity-text-align: middle-right;
    min-width: 56px;
}

.breakdown-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.breakdown-row--base {
    margin-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--hairline);
    padding-top: 4px;
}

.breakdown-row--total {
    border-top-width: 1px;
    border-top-color: var(--hairline);
    margin-top: 2px;
    padding-top: 4px;
}

.breakdown-row-label {
    flex-grow: 1;
    font-size: 14px;
    color: var(--ink-muted);
}

.breakdown-row--total .breakdown-row-label {
    color: var(--ink-soft);
    -unity-font-style: bold;
}

.breakdown-row-value {
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-right;
    min-width: 56px;
}

.breakdown-row--total .breakdown-row-value {
    font-size: 16px;
    -unity-font-style: bold;
}

/*
 * The hint that a value can be inspected. A value with no contributions still
 * opens a popover, so this is not a "has modifiers" signal; it marks the region
 * as interactive so the affordance is discoverable without a pointer.
 */
.breakdown-trigger {
    border-bottom-width: 1px;
    border-bottom-color: var(--transparent);
}

.breakdown-trigger:hover {
    border-bottom-color: var(--accent-dim);
}

.breakdown-trigger:focus {
    border-bottom-color: var(--accent);
}
