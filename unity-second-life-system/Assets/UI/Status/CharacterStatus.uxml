<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Status/CharacterStatus.uss?fileID=7433441132597879392&amp;guid=bd4692f221fe0f44889b9d558114a570&amp;type=3#CharacterStatus" />
    <ui:VisualElement name="status-root" class="status-root">
        <ui:VisualElement name="status-frame" class="status-frame">

            <ui:VisualElement name="status-header" class="status-header">
                <ui:VisualElement name="header-main" class="header-main">
                    <ui:VisualElement name="identity-block" class="identity-block">
                        <ui:Label name="status-heading" class="status-heading" text="STATUS" />

                        <ui:VisualElement name="status-identity" class="status-identity">
                            <ui:VisualElement name="identity-portrait-host" class="identity-portrait-host" />

                            <ui:VisualElement name="identity-details" class="identity-details">
                                <ui:Label name="character-name" class="character-name" />

                                <ui:VisualElement name="identity-meta" class="identity-meta">
                                    <ui:VisualElement name="identity-species-row" class="identity-meta-item">
                                        <ui:Label name="identity-species-caption" class="status-caption" text="Species" />
                                        <ui:Label name="identity-species" class="identity-meta-value" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="identity-gender-row" class="identity-meta-item">
                                        <ui:Label name="identity-gender-caption" class="status-caption" text="Gender" />
                                        <ui:Label name="identity-gender" class="identity-meta-value" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="identity-discipline-row" class="identity-meta-item">
                                        <ui:Label name="identity-discipline-caption" class="status-caption" text="Public discipline" />
                                        <ui:Label name="identity-public-discipline" class="identity-meta-value" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="status-summary" class="status-summary">
                        <ui:VisualElement name="summary-health-host" class="summary-bar-host" />
                        <ui:VisualElement name="summary-mana-host" class="summary-bar-host" />
                        <ui:VisualElement name="summary-row-grade" class="summary-row">
                            <ui:Label name="summary-label-grade" class="summary-label" text="GRADE" />
                            <ui:Label name="summary-grade" class="summary-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="status-content" class="status-content">
                <ui:VisualElement name="description-panel" class="content-panel content-panel--description">
                    <ui:Label name="description-heading" class="status-section-heading" text="BIOGRAPHY" />
                    <ui:Label name="identity-description" class="identity-description" />
                </ui:VisualElement>

                <!--
                  Attributes and vitals. This used to be one page of a two-tab strip;
                  Skills is a destination on the navigation bar now, so the strip had a
                  single tab left and was removed rather than kept as decoration.
                -->
                <ui:VisualElement name="tabs-panel" class="content-panel content-panel--tabs">
                    <ui:VisualElement name="status-body" class="status-body">
                        <ui:VisualElement name="status-attributes" class="status-column status-attributes">
                            <ui:Label name="attributes-heading" class="status-section-heading" text="ATTRIBUTES" />

                            <ui:VisualElement name="attribute-row-strength" class="attribute-row">
                                <ui:Label name="attribute-label-str" class="attribute-label" text="STR" />
                                <ui:Label name="attribute-strength" class="attribute-value" />
                            </ui:VisualElement>
                            <ui:VisualElement name="attribute-row-vitality" class="attribute-row">
                                <ui:Label name="attribute-label-vit" class="attribute-label" text="VIT" />
                                <ui:Label name="attribute-vitality" class="attribute-value" />
                            </ui:VisualElement>
                            <ui:VisualElement name="attribute-row-agility" class="attribute-row">
                                <ui:Label name="attribute-label-agi" class="attribute-label" text="AGI" />
                                <ui:Label name="attribute-agility" class="attribute-value" />
                            </ui:VisualElement>
                            <ui:VisualElement name="attribute-row-dexterity" class="attribute-row">
                                <ui:Label name="attribute-label-dex" class="attribute-label" text="DEX" />
                                <ui:Label name="attribute-dexterity" class="attribute-value" />
                            </ui:VisualElement>
                            <ui:VisualElement name="attribute-row-intelligence" class="attribute-row">
                                <ui:Label name="attribute-label-int" class="attribute-label" text="INT" />
                                <ui:Label name="attribute-intelligence" class="attribute-value" />
                            </ui:VisualElement>
                            <ui:VisualElement name="attribute-row-wisdom" class="attribute-row">
                                <ui:Label name="attribute-label-wis" class="attribute-label" text="WIS" />
                                <ui:Label name="attribute-wisdom" class="attribute-value" />
                            </ui:VisualElement>
                            <ui:VisualElement name="attribute-row-spirit" class="attribute-row">
                                <ui:Label name="attribute-label-spi" class="attribute-label" text="SPI" />
                                <ui:Label name="attribute-spirit" class="attribute-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="status-derived" class="status-column status-derived">
                            <ui:Label name="derived-heading" class="status-section-heading" text="VITALS" />

                            <ui:VisualElement name="derived-health-host" class="derived-bar-host" />
                            <ui:VisualElement name="derived-mana-host" class="derived-bar-host" />

                            <ui:Label name="derived-footnote" class="status-footnote" text="Shown as the System presents them. The world does not measure people this way." />

                            <ui:VisualElement name="status-assessment" class="status-assessment">
                                <ui:Label name="assessment-heading" class="status-section-heading" text="ASSESSMENT" />

                                <ui:VisualElement name="assessment-row-capability-grade" class="assessment-row">
                                    <ui:Label name="assessment-label-capability-grade" class="assessment-label" text="Capability grade" />
                                    <ui:Label name="assessment-capability-grade" class="assessment-value" />
                                </ui:VisualElement>
                                <ui:VisualElement name="assessment-row-guild-rank" class="assessment-row">
                                    <ui:Label name="assessment-label-guild-rank" class="assessment-label" text="Guild rank" />
                                    <ui:Label name="assessment-guild-rank" class="assessment-value" />
                                </ui:VisualElement>

                                <ui:Label name="assessment-label-titles" class="assessment-label assessment-label--titles" text="TITLES" />
                                <ui:VisualElement name="assessment-titles" class="status-titles" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="status-footer" class="status-footer">
                <ui:Label name="status-footer-hint" class="status-footer-hint" text="Skills and inventory have their own screens. Open them from the bar below." />
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
          The breakdown popover. Authored and hidden, shown by BreakdownPopover when
          the player hovers a value. It sits outside status-frame so a later change to
          the frame's layout cannot clip it.

          No overflow: hidden exists anywhere above it, which is why an absolutely
          positioned panel is safe here. If an ancestor ever gains overflow hidden,
          this must move.

          The contribution lines are inserted at runtime from BreakdownLine.uxml,
          because how many there are depends on the character's modifiers.
        -->
        <ui:VisualElement name="breakdown-popover" class="breakdown-popover">
            <ui:Label name="breakdown-title" class="breakdown-title" />
            <ui:VisualElement name="breakdown-lines" class="breakdown-lines" />

            <ui:VisualElement name="breakdown-base-row" class="breakdown-row breakdown-row--base">
                <ui:Label name="breakdown-base-label" class="breakdown-row-label" text="Base" />
                <ui:Label name="breakdown-base-value" class="breakdown-row-value" />
            </ui:VisualElement>

            <ui:VisualElement name="breakdown-total-row" class="breakdown-row breakdown-row--total">
                <ui:Label name="breakdown-total-label" class="breakdown-row-label" text="Final" />
                <ui:Label name="breakdown-total-value" class="breakdown-row-value" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
